{
	"name": "mlsem-vscode",
	"displayName": "MLsem",
	"description": "",
	"version": "0.0.1",
	"engines": {
		"vscode": "^1.110.0"
	},
	"categories": [
		"Programming Languages"
	],
	"main": "./dist/extension.js",
	"activationEvents": [],
	"contributes": {
		"commands": [
			{
				"command": "mlsem.helloWorld",
				"title": "MLsem: Hello World"
			}
		],
		"configuration": {
			"title": "MLsem",
			"properties": {
				"mlsem.server.path": {
					"default": null,
					"description": "Path to MLsem LSP server executable.",
					"scope": "machine-overridable",
					"type": [
						"null",
						"string"
					]
				},
				"mlsem.trace.server": {
					"description": "Trace setting of the MLsem language server.",
					"default": "off",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"scope": "window",
					"type": "string"
				}
			}
		},
		"grammars": [
			{
				"language": "mlsem",
				"scopeName": "source.mlsem",
				"path": "./syntaxes/mlsem.tmLanguage.json"
			}
		],
		"languages": [
			{
				"id": "mlsem",
				"aliases": [
					"MLsem"
				],
				"configuration": "./language-configuration.json",
				"extensions": [
					".mlsem"
				]
			}
		]
	},
	"scripts": {
		"build": "bun esbuild.config.mjs",
		"watch": "bun esbuild.config.mjs --watch",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"package": "bun esbuild.config.mjs --minify && bunx @vscode/vsce package --no-dependencies",
		"publish": "bunx @vscode/vsce publish --no-dependencies"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.10",
		"@types/bun": "^1.3.13",
		"@types/node": "^25.5.2",
		"@types/vscode": "^1.110.0",
		"@vscode/vsce": "^3.7.1",
		"esbuild": "^0.28.0",
		"typescript": "^6.0.2"
	},
	"dependencies": {
		"vscode-languageclient": "^9.0.1"
	}
}
