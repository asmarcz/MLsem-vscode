{
	"name": "mlsem-vscode",
	"displayName": "MLsem",
	"description": "",
	"version": "0.0.1",
	"engines": {
		"vscode": "^1.110.0"
	},
	"categories": [
		"Programming Languages"
	],
	"main": "./dist/extension.js",
	"activationEvents": [],
	"contributes": {
		"configurationDefaults": {
			"[mlsem]": {
				"editor.hover.above": false
			}
		},
		"commands": [
			{
				"command": "mlsem.helloWorld",
				"title": "MLsem: Hello World"
			},
			{
				"command": "mlsem.typeToolkit",
				"title": "MLsem: Type toolkit…"
			},
			{
				"command": "mlsem.restartServer",
				"title": "MLsem: Restart language server"
			},
			{
				"command": "mlsem.inferTypeWithLlm",
				"title": "MLsem: Infer type with LLM",
				"icon": "$(sparkle)"
			},
			{
				"command": "mlsem.setLlmApiKey",
				"title": "MLsem: Set LLM API key"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "mlsem.inferTypeWithLlm",
					"when": "editorLangId == mlsem",
					"group": "navigation"
				}
			]
		},
		"configuration": {
			"title": "MLsem",
			"properties": {
				"mlsem.server.path": {
					"default": null,
					"description": "Path to MLsem LSP server executable.",
					"scope": "machine-overridable",
					"type": [
						"null",
						"string"
					]
				},
				"mlsem.hover.overloadColors": {
					"default": true,
					"description": "In hovers of variables with several overloads, show a colour swatch per overload and tint the matching part of its `val` line in the editor while the hover is shown.",
					"scope": "window",
					"type": "boolean"
				},
				"mlsem.llm.baseUrl": {
					"default": "https://api.openai.com/v1",
					"description": "Base URL of the OpenAI-compatible endpoint used by `MLsem: Infer type with LLM`, e.g. `https://openrouter.ai/api/v1` or `http://localhost:11434/v1` for Ollama. The API key is set with `MLsem: Set LLM API key`.",
					"scope": "window",
					"type": "string"
				},
				"mlsem.llm.models": {
					"default": [],
					"description": "Models offered by `MLsem: Infer type with LLM`, as the endpoint names them. The one used is chosen in the type toolkit's LLM inference section, the first by default.",
					"scope": "window",
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"mlsem.llm.maxTries": {
					"default": 5,
					"minimum": 1,
					"description": "How many answers `MLsem: Infer type with LLM` asks for before giving up. Each rejected answer is sent back to the LLM with the type errors.",
					"scope": "window",
					"type": "integer"
				},
				"mlsem.llm.timeoutCountsAsFail": {
					"default": true,
					"description": "When an answer's type check times out: if on, it counts as a failed try and the LLM is asked again; if off, the inference stops there.",
					"scope": "window",
					"type": "boolean"
				},
				"mlsem.trace.server": {
					"description": "Trace setting of the MLsem language server.",
					"default": "off",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"scope": "window",
					"type": "string"
				}
			}
		},
		"grammars": [
			{
				"language": "mlsem",
				"scopeName": "source.mlsem",
				"path": "./syntaxes/mlsem.tmLanguage.json"
			}
		],
		"languages": [
			{
				"id": "mlsem",
				"aliases": [
					"MLsem"
				],
				"configuration": "./language-configuration.json",
				"extensions": [
					".mlsem"
				]
			}
		]
	},
	"scripts": {
		"build": "bun esbuild.config.mjs",
		"watch": "bun esbuild.config.mjs --watch",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"package": "bun esbuild.config.mjs --minify && bunx @vscode/vsce package --no-dependencies",
		"publish": "bunx @vscode/vsce publish --no-dependencies"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@types/bun": "^1.3.13",
		"@types/node": "^25.6.2",
		"@types/vscode": "^1.110.0",
		"@vscode/vsce": "^3.9.1",
		"esbuild": "^0.28.0",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"openai": "7.55.0",
		"preact": "^10.29.2",
		"vscode-languageclient": "^9.0.1"
	}
}
