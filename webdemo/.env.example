# /etc/webdemo/webdemo.env: read by podman-compose (--env-file) and by
# deploy/deploy.py. deploy/setup.py installs this file there if missing.

# URL path prefix the broker serves under (Caddy forwards it to the broker).
BASE_PATH=/webdemo
# Loopback port the broker is published on (Caddy dials 127.0.0.1:8080).
BROKER_PORT=8080
# Lifetime of a session container, in seconds.
SESSION_TTL_SECONDS=7200
# Seconds to wait after handing out a session before warming the next one.
WARMUP_DELAY_SECONDS=10
# Image of the session containers, built by compose.
SESSION_IMAGE=localhost/vscode-demo-code-server:latest
# Container-runtime socket the broker mounts: rootful Podman here.
# (Docker: /var/run/docker.sock. Rootless Podman:
# /run/user/<uid>/podman/podman.sock, with `loginctl enable-linger <user>`.)
DOCKER_SOCKET=/run/podman/podman.sock

# What a deploy builds: the head of each branch.
MLSEM_REPO=https://github.com/asmarcz/MLsem.git
MLSEM_BRANCH=webdemo
VSCODE_REPO=https://github.com/asmarcz/MLsem-vscode.git
VSCODE_BRANCH=master
PROJECT_REPO=https://github.com/asmarcz/MLsem-dummy-project.git
PROJECT_BRANCH=main
