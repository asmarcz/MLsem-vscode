# Settings of the webdemo host. deploy/setup.py installs this file as
# /etc/webdemo/webdemo.env (kept if it exists). It is read by:
#   - podman-compose (--env-file), started by webdemo-stack.service and by
#     deploy/deploy.py for the builds;
#   - deploy/deploy.py itself (EnvironmentFile of webdemo-deploy.service).
# The webhook settings are in /etc/webdemo/hook.env (root-only), which
# setup.py creates with a fresh secret: WEBHOOK_SECRET, and HOOK_TRIGGERS,
# the owner/repo:branch pairs whose pushes deploy.

# URL path prefix the broker serves under. The host-level Caddy config
# (caddy/Caddyfile -> /etc/caddy/Caddyfile) forwards this prefix to the broker.
BASE_PATH=/webdemo

BROKER_PORT=8080
SESSION_TTL_SECONDS=7200
SESSION_IMAGE=localhost/vscode-demo-code-server:latest

# Seconds to wait after handing out a session before warming the next pooled
# container, so container start does not steal CPU from the booting session.
#WARMUP_DELAY_SECONDS=10

# Host path to the container-runtime socket that the broker mounts. The server
# runs rootful Podman (systemctl enable --now podman.socket).
# Docker:                  /var/run/docker.sock (the compose default)
# Rootless Podman:         /run/user/<uid>/podman/podman.sock
#   (needs `loginctl enable-linger <user>`: without it systemd deletes
#   /run/user/<uid> when the user's last login ends, the broker keeps the
#   deleted socket mounted, and every request fails with ECONNREFUSED)
DOCKER_SOCKET=/run/podman/podman.sock

# What deploy/deploy.py builds: the head of each branch (defaults shown).
#MLSEM_REPO=https://github.com/asmarcz/MLsem.git
#MLSEM_BRANCH=webdemo
#VSCODE_REPO=https://github.com/asmarcz/MLsem-vscode.git
#VSCODE_BRANCH=master
#PROJECT_REPO=https://github.com/asmarcz/MLsem-dummy-project.git
#PROJECT_BRANCH=main
