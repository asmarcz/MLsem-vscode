# URL path prefix the broker serves under. The host-level Caddy config
# (caddy/Caddyfile -> /etc/caddy/Caddyfile) forwards this prefix to the broker.
BASE_PATH=/webdemo

BROKER_PORT=8080
SESSION_TTL_SECONDS=7200
SESSION_IMAGE=localhost/vscode-demo-code-server:latest

# Seconds to wait after handing out a session before warming the next pooled
# container, so container start does not steal CPU from the booting session.
#WARMUP_DELAY_SECONDS=10

# Host path to the container-runtime socket that the broker mounts.
# Docker (default):        /var/run/docker.sock
# Rootless Podman:         /run/user/<uid>/podman/podman.sock
#DOCKER_SOCKET=/var/run/docker.sock
#DOCKER_SOCKET=$XDG_RUNTIME_DIR/podman/podman.sock
